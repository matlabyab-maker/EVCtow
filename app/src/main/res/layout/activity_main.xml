<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/mainScrollView" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="false" android:scrollbars="vertical" android:fadeScrollbars="false" android:overScrollMode="ifContentScrolls">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#07142F" android:padding="3dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EVC • استودیو ویرایش ویدیو" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:gravity="center" android:paddingTop="0dp" android:paddingBottom="0dp" />

    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="یک ویدیو انتخاب کنید تا ۱۲۰ فریم در ۸ ردیف ساخته شود" android:textColor="#B9D7FF" android:textSize="9sp" android:gravity="center" android:paddingBottom="1dp" />

    <FrameLayout android:id="@+id/playerContainer" android:layout_width="match_parent" android:layout_height="180dp" android:background="#000000">
        <VideoView android:id="@+id/videoView" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ImageView android:id="@+id/playerColorPreview" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="پیش‌نمایش رنگ فریم فعلی" android:visibility="gone" />
        <TextView android:id="@+id/emptyHint" android:layout_width="match_parent" android:layout_height="match_parent" android:text="▶  پخش‌کنندهٔ EVC" android:textColor="#D7E7FF" android:textSize="20sp" android:gravity="center" android:background="#101F3D" />
    </FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="نوار زمان: کشیدن برای حرکت • دو انگشت برای بزرگ‌نمایی • انتخاب قطعه و برش" android:textColor="#B9D7FF" android:textSize="9sp" android:gravity="center" android:paddingTop="1dp" />
    <com.evc.app.TimelineView android:id="@+id/timelineView" android:layout_width="match_parent" android:layout_height="56dp" android:background="#10213E" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingTop="1dp" android:paddingBottom="2dp">
        <Button android:id="@+id/splitTimelineButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="Cut" android:textSize="8sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" />
        <Button android:id="@+id/pickStoryboardStartButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="2dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" android:text="ثبت شروع از پخش" android:textSize="7sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" />
        <Button android:id="@+id/pickStoryboardEndButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="2dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" android:text="ثبت پایان از پخش" android:textSize="7sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" />
        <Button android:id="@+id/deleteTimelineSegmentButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="2dp" android:text="حذف قطعه انتخابی" android:textSize="7sp" android:textColor="#FFFFFF" android:backgroundTint="#B52C45" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" />
        <Button android:id="@+id/restoreTimelineButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="2dp" android:text="بازگردانی قطعات" android:textSize="7sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" />
    </LinearLayout>

    <HorizontalScrollView android:id="@+id/exportActionsScroll" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:fillViewport="false" android:scrollbars="none" android:overScrollMode="never">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/exportButton" android:layout_width="112dp" android:layout_height="46dp" android:text="بدون تغییر کدک" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#43D9A3" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
            <Button android:id="@+id/exportOverlayButton" android:layout_width="142dp" android:layout_height="46dp" android:layout_marginStart="3dp" android:text="خروجی متن / ویدیوی رویی" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#43D9A3" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
            <Button android:id="@+id/muxTracksButton" android:layout_width="112dp" android:layout_height="46dp" android:layout_marginStart="3dp" android:text="خروجی ترک‌ها" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#43D9A3" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
            <Button android:id="@+id/exportFreeCropButton" android:layout_width="104dp" android:layout_height="46dp" android:layout_marginStart="3dp" android:text="خروجی Crop" android:textSize="9sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
            <Button android:id="@+id/colorizePreviewButton" android:layout_width="104dp" android:layout_height="46dp" android:layout_marginStart="3dp" android:text="خروجی رنگی" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#D7A6FF" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
            <Button android:id="@+id/exportSegmentsSeparatelyButton" android:layout_width="126dp" android:layout_height="46dp" android:layout_marginStart="3dp" android:text="خروجی قطعه‌ها جداگانه" android:textSize="9sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout android:id="@+id/freeCropControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone" android:gravity="center" android:padding="2dp">
        <Button android:id="@+id/applyFreeCropButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="ثبت محدوده" android:textSize="10sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" android:minHeight="0dp" android:minWidth="0dp" />
    </LinearLayout>


    
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="1dp" android:paddingBottom="1dp">
        <Button android:id="@+id/mergeButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:minHeight="0dp" android:minWidth="0dp" android:text="Merge • چند ویدیو" android:textSize="8sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#70AEFF" android:paddingLeft="1dp" android:paddingRight="1dp" />
        <Button android:id="@+id/imageSceneSearchButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:minHeight="0dp" android:minWidth="0dp" android:text="جست‌وجوی صحنه با عکس" android:textSize="8sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#D7A6FF" android:paddingLeft="1dp" android:paddingRight="1dp" />
        <Button android:id="@+id/openButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="1dp" android:paddingRight="1dp" android:text="انتخاب ویدیو" android:textSize="8sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#FFD21F" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="1dp" android:paddingBottom="1dp">
        <Button android:id="@+id/addAudioButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="1dp" android:paddingRight="1dp" android:text="افزودن صدا" android:textSize="8sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#70AEFF" />
        <Button android:id="@+id/addSubtitleButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="1dp" android:paddingRight="1dp" android:text="افزودن زیرنویس" android:textSize="8sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#D7A6FF" />
        <Button android:id="@+id/placeVideoOnPlayerButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1.1" android:layout_marginEnd="2dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="1dp" android:paddingRight="1dp" android:text="جای ویدیوی رویی" android:textSize="8sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" />
        <Button android:id="@+id/hidePlacementOverlayButton" android:layout_width="50dp" android:layout_height="46dp" android:text="×" android:textSize="14sp" android:textColor="#FFFFFF" android:backgroundTint="#B52C45" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" />
    </LinearLayout>

    

    <LinearLayout android:id="@+id/textOverlayPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#172B4D" android:padding="4dp" android:layout_marginTop="3dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="متن زنده روی ویدیو" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:gravity="center" />
        <EditText android:id="@+id/overlayTextInput" android:layout_width="match_parent" android:layout_height="42dp" android:hint="متن را بنویسید؛ هم‌زمان روی پلیر دیده می‌شود" android:singleLine="true" android:inputType="textCapSentences" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:textSize="12sp" android:backgroundTint="#D7A6FF" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <EditText android:id="@+id/overlayTextStartTime" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:hint="شروع متن 00:00" android:text="00:00" android:singleLine="true" android:inputType="text" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:textSize="10sp" android:gravity="center" android:backgroundTint="#D7A6FF" />
            <EditText android:id="@+id/overlayTextEndTime" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="3dp" android:hint="پایان متن" android:text="00:00" android:singleLine="true" android:inputType="text" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:textSize="10sp" android:gravity="center" android:backgroundTint="#D7A6FF" />
        </LinearLayout>
        <Button android:id="@+id/pickOverlayVideoButton" android:layout_width="match_parent" android:layout_height="42dp" android:text="انتخاب ویدیوی رویی" android:textSize="10sp" android:textColor="#07142F" android:backgroundTint="#70AEFF" android:minHeight="0dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="این دکمه خروجی نهایی متن و ویدیوی رویی را می‌سازد؛ دکمهٔ «ساخت خروجی ترک‌ها» برای صدا و زیرنویس است." android:textColor="#B9D7FF" android:textSize="9sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="شروع و پایان متن را وارد کنید؛ برای تنظیم جای متن و اندازهٔ متن یا ویدیوی رویی، روی پلیر بکشید و گوشه‌های کادر را تغییر دهید." android:textColor="#B9D7FF" android:textSize="9sp" />
    </LinearLayout>



    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="32dp" android:fillViewport="false" android:scrollbars="none" android:overScrollMode="never">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/outputFormatButton" android:layout_width="92dp" android:layout_height="46dp" android:text="فرمت: MP4" android:textSize="9sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
            <Button android:id="@+id/joinAfterButton" android:layout_width="104dp" android:layout_height="46dp" android:layout_marginStart="2dp" android:text="Join • افزودن به انتها" android:textSize="8sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#FFD21F" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" />
            <Button android:id="@+id/vectorButton" android:layout_width="90dp" android:layout_height="46dp" android:text="Vector" android:textSize="8sp" android:textColor="#07142F" android:backgroundTint="#70AEFF" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="1dp" android:paddingRight="1dp" />
            <Button android:id="@+id/cropButton" android:layout_width="90dp" android:layout_height="46dp" android:text="Crop" android:textSize="9sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="1dp" android:paddingRight="1dp" />
            <Button android:id="@+id/advancedEditButton" android:layout_width="88dp" android:layout_height="46dp" android:text="ویرایش پیشرفته" android:textSize="8sp" android:textColor="#07142F" android:backgroundTint="#D7A6FF" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="1dp" android:paddingRight="1dp" />
            <Button android:id="@+id/timeModeButton" android:layout_width="72dp" android:layout_height="46dp" android:text="نمایش زمانی" android:textSize="8sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="1dp" android:paddingRight="1dp" />
            <Button android:id="@+id/selectAllButton" android:layout_width="70dp" android:layout_height="46dp" android:text="انتخاب همه" android:textSize="8sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="1dp" android:paddingRight="1dp" />
            <Button android:id="@+id/clearSelectionButton" android:layout_width="70dp" android:layout_height="46dp" android:text="لغو انتخاب" android:textSize="8sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="1dp" android:paddingRight="1dp" />
            <Button android:id="@+id/deleteSelectedButton" android:layout_width="70dp" android:layout_height="46dp" android:text="حذف بازه‌ها" android:textSize="8sp" android:textColor="#FFFFFF" android:backgroundTint="#B52C45" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="1dp" android:paddingRight="1dp" />
            <Button android:id="@+id/selectForDeleteModeButton" android:layout_width="90dp" android:layout_height="46dp" android:text="انتخاب برای حذف" android:textSize="8sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="1dp" android:paddingRight="1dp" />
            <Button android:id="@+id/selectForExportModeButton" android:layout_width="94dp" android:layout_height="46dp" android:text="انتخاب برای خروجی" android:textSize="8sp" android:textColor="#FFFFFF" android:backgroundTint="#25456F" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="1dp" android:paddingRight="1dp" />
        </LinearLayout>
    </HorizontalScrollView>


    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="1dp" android:paddingBottom="1dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="فاصلهٔ اسلایدها" android:textColor="#B9D7FF" android:textSize="9sp" android:paddingEnd="5dp" />
        <EditText android:id="@+id/storyboardIntervalTime" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" android:hint="اختیاری: ثانیه یا دقیقه:ثانیه" android:text="" android:singleLine="true" android:inputType="text" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:textSize="9sp" android:padding="4dp" android:backgroundTint="#FFD21F" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="خالی = خودکار" android:textColor="#B9D7FF" android:textSize="8sp" android:paddingStart="5dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="1dp" android:paddingBottom="2dp">
        <EditText android:id="@+id/storyboardStartTime" android:layout_width="0dp" android:layout_height="25dp" android:layout_weight="1" android:hint="شروع 00:00" android:text="00:00" android:singleLine="true" android:inputType="text" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:textSize="9sp" android:padding="4dp" android:backgroundTint="#FFD21F" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تا" android:textColor="#B9D7FF" android:paddingStart="4dp" android:paddingEnd="4dp" />
        <EditText android:id="@+id/storyboardEndTime" android:layout_width="0dp" android:layout_height="25dp" android:layout_weight="1" android:hint="پایان 01:00" android:text="01:00" android:singleLine="true" android:inputType="text" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:textSize="9sp" android:padding="4dp" android:backgroundTint="#FFD21F" />
        <Button android:id="@+id/applyStoryboardTimeRangeButton" android:layout_width="wrap_content" android:layout_height="46dp" android:text="اعمال زمان" android:textSize="9sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="1dp" android:paddingBottom="1dp">
        <TextView android:id="@+id/selectionText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="انتخاب‌شده: ۰ فریم از ۹۰" android:textColor="#FFD21F" android:textSize="9sp" />
        </LinearLayout>



    <TextView android:id="@+id/storyboardScrollHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="استوری‌بورد • همهٔ ۱۲۰ اسلاید در شبکهٔ ثابت نمایش داده می‌شوند؛ برای دیدن ادامه صفحه را عمودی پیمایش کنید" android:textColor="#FFD21F" android:textSize="10sp" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" />
    <LinearLayout android:id="@+id/storyboardRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تنظیم دستی رنگ خروجی (ضریب هر کانال: ۰ تا ۲)" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center" android:paddingTop="0dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="3dp">
            <TextView android:id="@+id/redColorValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="قرمز 1.00" android:textColor="#FF8A8A" android:textSize="9sp" android:gravity="center" />
            <SeekBar android:id="@+id/redColorSeek" android:layout_width="match_parent" android:layout_height="18dp" android:max="200" android:progress="112" android:contentDescription="ضریب کانال قرمز" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="2dp" android:paddingEnd="2dp">
            <TextView android:id="@+id/greenColorValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="سبز 1.00" android:textColor="#8AFFB8" android:textSize="9sp" android:gravity="center" />
            <SeekBar android:id="@+id/greenColorSeek" android:layout_width="match_parent" android:layout_height="18dp" android:max="200" android:progress="100" android:contentDescription="ضریب کانال سبز" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="3dp">
            <TextView android:id="@+id/blueColorValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="آبی 0.82" android:textColor="#8ABEFF" android:textSize="9sp" android:gravity="center" />
            <SeekBar android:id="@+id/blueColorSeek" android:layout_width="match_parent" android:layout_height="18dp" android:max="200" android:progress="82" android:contentDescription="ضریب کانال آبی" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp">
        <TextView android:id="@+id/saturationValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اشباع رنگ 1.00" android:textColor="#FFD21F" android:textSize="9sp" android:gravity="center" />
        <SeekBar android:id="@+id/saturationSeek" android:layout_width="match_parent" android:layout_height="22dp" android:max="200" android:progress="100" android:contentDescription="اشباع رنگ ویدیو از صفر تا دو برابر" />
    </LinearLayout>

    <Button android:id="@+id/applyColorToSelectedButton" android:layout_width="match_parent" android:layout_height="46dp" android:minHeight="46dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingLeft="8dp" android:paddingRight="8dp" android:gravity="center" android:includeFontPadding="true" android:singleLine="false" android:text="ثبت این ترکیب رنگ برای اسلایدهای انتخابی" android:textSize="13sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#FFD21F" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp">
